# Local-development template only. Replace every placeholder before use.
# Required application configuration
PORT=3000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinics
POSTGRES_USER=clinics
POSTGRES_PASSWORD=replace-with-a-development-password

# Generate unique, high-entropy values for each environment.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRE=5m
JWT_REFRESH_EXPIRE=7d

ROOT_ADMIN_EMAIL=admin@example.com
ROOT_ADMIN_PASSWORD=replace-with-a-development-password
ROOT_ADMIN_FIRST_NAME=Root
ROOT_ADMIN_LAST_NAME=Admin

NODE_ENV=development
# Defaults to false. Set true only for local development when explicitly needed.
DATABASE_SYNCHRONIZE=false
